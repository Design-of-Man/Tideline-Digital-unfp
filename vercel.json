{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    },
    {
      "source": "/assets/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, must-revalidate"
        }
      ]
    },
    {
      "source": "/og.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/journey",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/journey.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v2.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v2-process",
      "destination": "/process",
      "permanent": true
    },
    {
      "source": "/v2-process.html",
      "destination": "/process",
      "permanent": true
    },
    {
      "source": "/v2-studio",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/v2-studio.html",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/v2-contact",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/v2-contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": true
    }
  ]
}
